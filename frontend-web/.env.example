# Copiar a .env y ajustar a tu entorno. .env NO se versiona (esta en .gitignore).
#
# URL base del backend Laravel, INCLUYENDO el prefijo /api/v1.
# - Backend en la MISMA maquina que el frontend:
#       VITE_API_URL=http://localhost:8000/api/v1
# - Backend en OTRA laptop de la misma red (LAN):
#       VITE_API_URL=http://IP_BACKEND:8000/api/v1
#   (sustituir IP_BACKEND por la IP de esa laptop, ej. 192.168.1.50)
# - Backend remoto (otra red, expuesto con un tunel): usar la ruta relativa y
#   apoyarse en el proxy /api de vite.config.ts (mismo origen, sin depender del
#   CORS del backend):
#       VITE_API_URL=/api/v1
VITE_API_URL=http://IP_BACKEND:8000/api/v1

# true = usa mocks locales (credenciales mock: admin123 / cliente123).
# false = llama al backend real.
VITE_MOCK_MODE=true
